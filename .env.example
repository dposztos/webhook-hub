# Copy this file to .env and fill in the blanks.
#
#   cp .env.example .env
#   docker compose run --rm app php artisan key:generate --show
#
# .env is git-ignored on purpose: it holds your database password, SMTP
# credentials and the admin password. Never commit it.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Webhook Hub"

# The image to run. The default has Python for script actions; build
# webhook-hub:db2 (docker/prod/Dockerfile.db2) if those scripts need the
# IBM i (AS/400) ODBC driver, and name it here.
APP_IMAGE=ghcr.io/dposztos/webhook-hub:latest
APP_ENV=production
APP_DEBUG=false

# Required. 32 random bytes, base64-encoded: `php artisan key:generate --show`.
APP_KEY=

# The public base URL. Generated webhook URLs use this host, so it must be the
# address senders can actually reach — not localhost, if they are remote.
APP_URL=http://localhost:8080

# Port published on the host by docker-compose.yml.
APP_HOST_PORT=8080

APP_TIMEZONE=UTC

# UI and e-mail language: "en" or "hu" (see lang/ to add your own).
APP_LOCALE=en

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=webhookhub
DB_USERNAME=webhookhub
# Required, no default. Pick something long and random.
DB_PASSWORD=

# ── Session, queue, cache ────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# "true" behind HTTPS, "false" for plain HTTP. Getting this wrong is the most
# common install problem: with "true" over HTTP the browser silently drops the
# session cookie and the login form just reloads itself.
# Outside Docker, Laravel reads this as SESSION_SECURE_COOKIE.
SESSION_SECURE=false

QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── First admin user ─────────────────────────────────────────────────────────
# Created (or its password updated) on every container start. There is no
# public sign-up: users are created here or with `php artisan webhook:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Which peers are allowed to set X-Forwarded-For, and therefore decide the IP
# recorded on a message and counted against the rate limits. "*" trusts every
# peer, which is right behind a reverse proxy you control and wrong on an
# instance exposed directly — there, anyone can claim any address. Narrow it to
# your proxy ("10.0.0.5" or a comma-separated list) or set it empty.
#
# Note: this is read with env(), so on a bare-metal install running
# `artisan config:cache` without a process-level variable it falls back to "*".
TRUSTED_PROXIES=*

# ── Webhook behaviour ────────────────────────────────────────────────────────
# Request bodies larger than this are stored truncated, with a marker.
WEBHOOK_MAX_BODY_BYTES=524288

# Incoming requests per minute per IP address (0 = unlimited).
WEBHOOK_INGEST_RATE_LIMIT=600

# Global default retention. Empty = keep everything forever, which is the
# point of this fork. Individual endpoints can override it.
WEBHOOK_RETENTION_DAYS=

# Ceiling on actions run for a single message, as a loop guard.
WEBHOOK_MAX_ACTIONS=20

# ── Python script actions ────────────────────────────────────────────────────
# A rule can run a Python script when a webhook arrives. That is code execution
# on the server, driven from the admin UI, so it is off until you switch it on.
WEBHOOK_SCRIPTS_ENABLED=false

# Host folder holding the .py files, mounted into the container read-only.
# On Windows use a full path, e.g. C:\webhookhub\scripts
WEBHOOK_SCRIPTS_HOST_DIR=./scripts

# Where that folder appears inside the container. Only files under it can run.
WEBHOOK_SCRIPTS_DIR=/app/scripts

# The interpreter. The image ships /usr/bin/python3; on a native install point
# this at the python.exe you want.
WEBHOOK_PYTHON_BIN=/usr/bin/python3

# Whether a rule may hold its own code instead of pointing at a file. With this
# on, anyone who can log in can run arbitrary code on the server.
WEBHOOK_SCRIPTS_ALLOW_INLINE=false

# Seconds a single run may take: the default, and the ceiling a rule may ask for.
WEBHOOK_SCRIPT_TIMEOUT=30
WEBHOOK_SCRIPT_MAX_TIMEOUT=300

# How much stdout/stderr is kept per run, in bytes.
WEBHOOK_SCRIPT_MAX_OUTPUT=65536

# Install <scripts>/requirements.txt when the container starts, into a
# virtualenv, and run scripts with that interpreter. A new library then needs a
# restart rather than a rebuilt image. Only reinstalls when the file changed; if
# it fails the app still starts, and the rule editor shows what pip said.
WEBHOOK_SCRIPTS_REQUIREMENTS=false

# ── Db2 for i (AS/400) ───────────────────────────────────────────────────────
# Read by scripts/as400.py. Kept here rather than in a rule so the password
# never goes into the database. Needs the DB2-capable image; see docs/as400.md.
AS400_HOST=
AS400_USER=
AS400_PASSWORD=
# Library list, comma separated. The first one is the default schema.
AS400_LIBRARIES=
# 0 = SQL naming (LIB.FILE), 1 = system naming (LIB/FILE) with library list.
AS400_NAMING=0
# Commit mode: 0 = *NONE. Anything else fails on tables that are not journalled.
AS400_COMMIT=0

# ── Mail (needed only for e-mail actions) ────────────────────────────────────
# "log" writes mail to the log instead of sending; "smtp" actually sends.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# STARTTLS on port 587 wants "smtp"; use "smtps" only for port 465.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=webhook-hub@example.com
MAIL_FROM_NAME="Webhook Hub"

# Optional allow-list for e-mail action recipients, comma separated. Supports
# wildcards: "*@example.com,ops@other.org". Empty = any recipient allowed.
WEBHOOK_ALLOWED_RECIPIENTS=
